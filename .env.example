# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Tavily API Configuration
TAVILY_API_KEY=your_tavily_api_key_here

# Database Configuration (Neon Serverless PostgreSQL)
# Get your connection string from: https://console.neon.tech/
# Format: postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require
# Example: postgresql://myuser:mypass@ep-cool-morning-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-endpoint.neon.tech/neondb?sslmode=require

# SMTP Configuration (for sending emails)
SMTP_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Testing Configuration
TEST_EMAIL_RECIPIENT=your_test_email@example.com

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
